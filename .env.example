# ============================================================
# TENUTE WEB — Variables de entorno requeridas para producción
# Copiar como .env.local y rellenar con valores reales.
# NUNCA commitear .env.local al repositorio.
# ============================================================

# ── Supabase (obligatorio) ───────────────────────────────
# Obtener en: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — solo server-side (API routes). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Panel de administración ──────────────────────────────
# Contraseña del admin panel (/admin/login)
ADMIN_PASSWORD=cambia_esto_en_produccion

# ── Flow.cl (pagos con tarjeta) ──────────────────────────
# Obtener en: https://www.flow.cl/app/web/misDatos.php
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Sandbox: usar 'true' para pruebas, 'false' o vacío en producción
FLOW_SANDBOX=true

# ── Starken (despacho nacional) ──────────────────────────
# Solicitar a Starken: 600 200 0102
STARKEN_API_KEY=

# ── Email / notificaciones ───────────────────────────────
# Email origen para notificaciones de pedidos (debe estar verificado en tu proveedor SMTP)
EMAIL_FROM=noreply@tenute.cl
# SMTP (usando Resend, SendGrid, SES, etc.)
# Ejemplo con Resend: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# O bien con Nodemailer/SMTP genérico:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=usuario@gmail.com
# SMTP_PASS=contraseña_app

# ── Instagram (scraping de posts, opcional) ──────────────
# Session cookie de Instagram (_sessionid) para el scraper interno.
# Solo necesario si se usa /api/admin/instagram
INSTAGRAM_SESSION_ID=

# ── MercadoPago (Checkout Pro) ───────────────────────────
# Access token privado del vendedor. Habilita /api/mercadopago/create-preference.
# El webhook de notificaciones vive en /api/mercadopago/webhook y usa NEXT_PUBLIC_BASE_URL.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxx

# ── Mercado Libre (dropshipping: publicar productos + recibir órdenes) ──
# Crea la app en: https://developers.mercadolibre.cl/ → Mis aplicaciones
# ML_APP_ID = Client ID de la app; ML_CLIENT_SECRET = Client Secret.
# ML_REDIRECT_URI debe coincidir EXACTAMENTE con la Redirect URI configurada
# en la app de ML y apuntar a /api/ml/callback (ej. https://www.tenute.cl/api/ml/callback).
# Flujo: visitar /api/ml/auth para autorizar; el webhook de órdenes vive en /api/ml/webhook.
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://www.tenute.cl/api/ml/callback

# ── URL base (callbacks, canonicals) ────────────────────
# Se auto-detecta en Vercel. Solo definir si usas dominio propio.
NEXT_PUBLIC_BASE_URL=https://www.tenute.cl

# ── Base de datos directa (migraciones, opcional) ────────
# Formato: postgresql://postgres.{ref}:{password}@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── APIs de código de barras (escaner de productos) ─────────────────────
# El sistema usa cascada: primero APIs con key → luego APIs gratuitas
# Sin keys solo funcionan: Open Food Facts + UPC Item DB (100 req/day)
# Los EAN chilenos (780xxxx) rara vez están en bases gratuitas.
# Para cobertura LATAM completa se recomienda al menos una de estas APIs:

# Go-UPC — mejor cobertura LATAM, 500M productos (desde $75/mes)
# Registro: https://go-upc.com/plans/api
BARCODE_API_KEY=

# Barcode Lookup — 500M+ productos globales (desde $99/mes)
# Registro: https://www.barcodelookup.com/api
BARCODE_LOOKUP_API_KEY=

# EAN-Search.org — 900M EANs globales, tier gratuito: 20 req/día
# Tier de pago desde ~€10/mes con miles de consultas
# Registro: https://www.ean-search.org/
EAN_SEARCH_API_KEY=

# Google Custom Search — fallback web cuando ninguna API tiene el EAN
# GRATIS: 100 búsquedas/día. Configurar en:
# 1. Crear API Key: https://console.cloud.google.com/apis/credentials
#    (habilitar "Custom Search API")
# 2. Crear motor de búsqueda: https://programmablesearchengine.google.com/
#    (seleccionar "Buscar en toda la web")
# 3. Copiar el ID del motor (CX) y la API Key aquí
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Sin estas variables el sistema igual funciona usando DuckDuckGo como fallback final (sin key)

# Brave Search API — GRATIS: 2000 búsquedas/mes (RECOMENDADO para fallback web)
# Mejor que DuckDuckGo scraping, más confiable y con miniaturas de imagen
# Registro: https://api.search.brave.com/ (sin tarjeta de crédito)
BRAVE_SEARCH_API_KEY=

# SerpAPI — 100 búsquedas/mes gratis, devuelve resultados de shopping de Google
# Ideal para obtener precio + imagen del producto directamente

# ── Facebook Pixel ──────────────────────────────────────────
# Pixel ID de Facebook para tracking de conversiones
# Obtener en: Facebook Business Manager → Events Manager
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1217451877139610
# Registro: https://serpapi.com/register (sin tarjeta de crédito)
SERP_API_KEY=
